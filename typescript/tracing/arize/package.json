{
  "name": "respan-arize-typescript-example",
  "version": "0.1.0",
  "description": "TypeScript Arize Phoenix tracing examples for Respan",
  "type": "module",
  "scripts": {
    "01:trace-helpers": "tsx 01_trace_helpers.ts",
    "02:manual-llm": "tsx 02_manual_llm_attributes.ts",
    "03:retrieval-redaction": "tsx 03_retrieval_embedding_redaction.ts",
    "04:decorators": "tsx 04_observe_decorator.ts",
    "all": "tsx 01_trace_helpers.ts && tsx 02_manual_llm_attributes.ts && tsx 03_retrieval_embedding_redaction.ts && tsx 04_observe_decorator.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arizeai/phoenix-otel": "2.2.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@respan/instrumentation-arize": "file:../../../../respan/javascript-sdks/instrumentations/respan-instrumentation-arize",
    "@respan/instrumentation-openinference": "1.2.1",
    "@respan/respan": "2.5.0",
    "@respan/respan-sdk": "1.3.4",
    "@respan/tracing": "1.6.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  },
  "private": true
}
