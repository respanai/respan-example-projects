    "examples": "npm run build && tsx examples/run_all.ts"
  },
  "dependencies": {
    "@respan/instrumentation-eve": "file:../../../../respan/javascript-sdks/instrumentations/respan-instrumentation-eve",
    "@respan/respan-sdk": "^1.2.0",
    "@respan/tracing": "^1.6.0",
    "ai": "7.0.136",
    "dotenv": "^17.2.3",
    "eve": "0.75.1",
    "zod": "4.4.3",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "just-bash": "3.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.20.6",
    "typescript": "5.7.3"
  }
