{
  "name": "respan-eve-typescript-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsx scripts/prepare.ts",
    "info": "eve info",
    "typecheck": "tsc --noEmit",
    "example:basic": "npm run build && tsx examples/01_basic_turn.ts",
    "example:tool": "npm run build && tsx examples/02_tool_call.ts",
