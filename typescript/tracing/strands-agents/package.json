{
  "name": "respan-strands-agents-typescript-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "01:basic": "node --import tsx 01_basic_invoke.ts",
    "02:tool": "node --import tsx 02_tool_call.ts",
    "03:streaming": "node --import tsx 03_streaming.ts",
    "04:structured": "node --import tsx 04_structured_output.ts",
    "05:graph": "node --import tsx 05_graph.ts",
    "06:swarm": "node --import tsx 06_swarm.ts",
    "07:mcp": "node --import tsx 07_mcp_tool.ts",
    "all": "npm run 01:basic && npm run 02:tool && npm run 03:streaming && npm run 04:structured && npm run 05:graph && npm run 06:swarm && npm run 07:mcp && npm run 08:privacy && npm run 09:error && npm run 10:large",
    "typecheck": "tsc --noEmit",
    "08:privacy": "node --import tsx 08_content_privacy.ts",
    "09:error": "node --import tsx 09_provider_error.ts",
    "10:large": "node --import tsx 10_large_payload.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
