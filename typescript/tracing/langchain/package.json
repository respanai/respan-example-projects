{
  "name": "respan-langchain-typescript-examples",
  "version": "0.1.0",
  "description": "Numbered TypeScript examples for Respan LangChain instrumentation",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "run:all": "set -e; for file in [0-9][0-9]_*.ts; do echo \"== $file ==\"; tsx \"$file\"; done",
    "00": "tsx 00_quickstart.ts"
  },
  "dependencies": {
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.4.21",
    "@respan/instrumentation-langchain": "file:../../../../respan/javascript-sdks/instrumentations/respan-instrumentation-langchain",
    "@respan/respan": "2.5.0",
    "langchain": "1.5.16",
    "zod": "^4.2.0",
    "@langchain/openai": "1.6.2",
    "@respan/tracing": "1.6.1",
    "@respan/respan-sdk": "1.3.4",
    "@opentelemetry/sdk-trace-base": "^2.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
