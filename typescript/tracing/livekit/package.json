{
  "name": "respan-livekit-typescript-example",
  "version": "0.1.0",
  "description": "TypeScript LiveKit Agents tracing examples for Respan",
  "private": true,
  "type": "module",
  "scripts": {
    "01:text-turn": "node --import tsx 01_text_agent_turn.ts",
    "02:tool-call": "node --import tsx 02_tool_call.ts",
    "03:handoff": "node --import tsx 03_agent_handoff.ts",
    "04:features": "node --import tsx 04_native_features.ts",
    "05:privacy-errors": "node --import tsx 05_privacy_errors.ts",
    "06:opt-out": "node --import tsx 06_content_opt_out.ts",
    "typecheck": "tsc --noEmit",
    "all": "npm run 01:text-turn && npm run 02:tool-call && npm run 03:handoff && npm run 04:features && npm run 05:privacy-errors && npm run 06:opt-out"
  },
  "dependencies": {
    "@livekit/agents": "1.9.2",
    "@livekit/agents-plugin-openai": "1.9.2",
    "@livekit/rtc-node": "^1.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@respan/instrumentation-livekit": "file:../../../../respan/javascript-sdks/instrumentations/respan-instrumentation-livekit",
    "@respan/respan": "2.5.0",
    "@respan/respan-sdk": "1.3.4",
    "@respan/tracing": "1.6.1",
    "openai": "^6.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
